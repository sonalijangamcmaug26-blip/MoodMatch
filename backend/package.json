{
  "name": "moodmatch-backend",
  "version": "1.0.0",
  "description": "REST API for MoodMatch - mood based book and movie recommendations",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node scripts/setupDb.js",

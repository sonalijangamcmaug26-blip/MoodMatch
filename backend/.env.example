# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

PORT=5000

# MySQL connection (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=moodmatch

# JWT - use a long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS (comma separated for several).
# During development localhost / 127.0.0.1 on any port is also accepted.
CLIENT_URL=http://localhost:5173

# Set to production when deploying (turns off the localhost CORS shortcut)
NODE_ENV=development
